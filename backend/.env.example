# Backend Environment Variables
# Copy to .env and customize

# Database Configuration
DATABASE_URL=postgresql://diving:CHANGE_ME_USE_RUNTIME_ENV@localhost:6432/diving_analyzer_db

# API Configuration
API_TITLE=Diving Analytics API
API_VERSION=1.0.0

# Python Configuration
PYTHONUNBUFFERED=1

# Legacy Mode (Photos library access)
LEGACY_MODE=true
PHOTOS_LIBRARY_PATH=/Users/you/Pictures/Photos Library.photoslibrary

# Auto-import on startup
AUTO_IMPORT=false

# Both available and missing backbone lookups expire; 0 disables caching.
MEDIA_BACKBONE_LOOKUP_CACHE_TTL_SECONDS=30

# Require login for the shared dive/analytics workspace when enabled.
# Playback additionally requires the existing explicit diver ownership grants.
USER_AUTH_ENABLED=false

# Friend access: invite-gated self-registration for read-only users who see
# every diver by default. Both must be set (registration stays closed
# otherwise). Share the invite code with friends out-of-band; rotate by
# replacing it (existing friend accounts keep working).
#
# Independent of the above: administrators can also mint a one-time signup
# link for a specific diver name from Administration -> Invites. That path
# needs neither of these variables (only USER_AUTH_ENABLED) and binds the
# new account to the invited diver. The link is a pure bearer credential:
# keep DIVER_INVITE_TTL_SECONDS short and revoke links you do not recognise.
FRIEND_REGISTRATION_ENABLED=false
FRIEND_INVITE_CODES=CHANGE_ME_USE_RUNTIME_ENV

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO

# Machine-to-machine API authentication. Set in runtime .env only.
MAC_AGENT_API_KEYS=CHANGE_ME_USE_RUNTIME_ENV
CORS_ALLOW_ORIGINS=http://192.168.1.57:6090,https://192.168.1.57:6443

# Deposit batches: operator account credited as depositor for machine-key
# ingestion (empty = unknown depositor). Batch email via a free Gmail SMTP
# maintainer account (2FA + app password). Keep in the deployment
# environment (e.g. ~/.config/diveanalyzer/email.env, mode 600), never in Git.
# Empty SMTP_HOST disables sending (outbox stays pending, inbox+push unaffected).
INGEST_DEPOSITOR_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Dive Analyser <diveanalyser.notifs@gmail.com>
APP_PUBLIC_URL=
BATCH_EMAIL_DELAY_MINUTES=45
CLAIM_TOKEN_TTL_SECONDS=604800
# Diver invitation-link lifetime. These links create an account and grant
# diver ownership, so treat them as bearer credentials and keep this short.
DIVER_INVITE_TTL_SECONDS=604800
