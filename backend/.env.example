# Backend Environment Variables
# Copy to .env and customize

# Database Configuration
DATABASE_URL=postgresql://diving:REDACTED-HISTORICAL-DB-CREDENTIAL@localhost:6432/diving_analyzer_db

# API Configuration
API_TITLE=Diving Analytics API
API_VERSION=1.0.0

# Python Configuration
PYTHONUNBUFFERED=1

# Legacy Mode (Photos library access)
LEGACY_MODE=true
PHOTOS_LIBRARY_PATH=/Users/you/Pictures/Photos Library.photoslibrary

# Auto-import on startup
AUTO_IMPORT=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
