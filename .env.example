# PostgreSQL Database Configuration
POSTGRES_DB=diving_analyzer_db
POSTGRES_USER=diving
POSTGRES_PASSWORD=change_me_in_production

# Backend Configuration
DATABASE_URL=postgresql://diving:change_me_in_production@postgres:5432/diving_analyzer_db
API_TITLE=Diving Analytics API
API_VERSION=1.0.0
PYTHONUNBUFFERED=1

# Legacy Mode (enable Photos library access)
LEGACY_MODE=true
PHOTOS_LIBRARY_PATH=/photos_library

# Auto-import on startup
AUTO_IMPORT=true

# Frontend Configuration
VITE_API_URL=/api
VITE_WS_URL=/api/v1/ws
VITE_HMR_HOST=localhost

# Nginx Proxy
PROXY_TARGET=http://backend:8000

# Web Push (PR3 notifications-push, optional): VAPID credentials for push
# fan-out to subscribed devices. Leave all three empty to keep push
# gracefully disabled (in-app inbox and prefs keep working). Generate once
# with e.g. `npx web-push generate-vapid-keys`, then set the real values in
# the runtime .env on the server only — never commit real keys here.
# VAPID_SUBJECT is a contact URL or mailto: for the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
