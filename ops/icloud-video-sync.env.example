# Copy to ops/icloud-video-sync.env for local overrides.

# Existing iCloudPD container and paths.
ICLOUDPD_CONTAINER=icloudpd
ICLOUDPD_DOWNLOAD_ROOT=/home/mcauchy/icloudpd/downloads

# The iCloud album that should contain only dive videos/clips for this app.
# Keep this narrow; do not point the app at the whole iCloud library.
ICLOUDPD_ALBUM=Dive Analyzer

# Bounded discovery. These protect us from accidentally traversing/downloading a full library.
ICLOUDPD_RECENT=500
ICLOUDPD_UNTIL_FOUND=75
ICLOUDPD_SKIP_CREATED_BEFORE=2026-01-01

# App cache exposed to backend as /videos.
APP_VIDEO_CACHE=/home/mcauchy/dive-analyser/media/videos

# Local retention only. This does not delete from iCloud.
VIDEO_CACHE_RETENTION_DAYS=90
VIDEO_CACHE_MAX_BYTES=53687091200
