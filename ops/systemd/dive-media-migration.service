[Unit]
Description=Dive Analyser historical media migration tick (bounded, idempotent)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=mcauchy
WorkingDirectory=/home/mcauchy/dive-analyser
ExecStart=/home/mcauchy/dive-analyser/ops/media-migration.sh
TimeoutStartSec=300
Nice=10
