# Copy to ops/postgres-backup.env (0600, owner-only) for local overrides.
# NEVER commit the real env file or the encryption key.

# Container / database identity (defaults match the production deployment).
#POSTGRES_CONTAINER=dive-analyser-postgres-1
#POSTGRES_USER=diving
#POSTGRES_DB=diving_analyzer_db

# Local encrypted backup destination + retention (files, not rows).
#BACKUP_DIR=/home/mcauchy/backups/postgres
#BACKUP_KEEP_DAILY=14
#BACKUP_KEEP_WEEKLY=8

# Off-host replication of the ENCRYPTED backup (different failure domain).
# The push key must be a dedicated SSH key (see
# docs/architecture/BACKUP_AND_RETENTION_V1.md §off-host). rsync dest form:
#   user@host:/abs/path/
#BACKUP_OFFHOST_DEST=divesensei@192.168.1.19:/Users/Shared/services/data/diveanalyzer-backups/postgres/
#BACKUP_OFFHOST_KEY=/home/mcauchy/.ssh/id_ed25519_backup_push
