#!/bin/bash
# dive-analyser CI gate; source is versioned, installed by ci/install-hooks.sh.
set -euo pipefail
REPO="$(git rev-parse --show-toplevel)"
GATE="$REPO/ci/gate.sh"
ZERO=0000000000000000000000000000000000000000

if [ "${DIVE_CI_SKIP:-0}" = 1 ]; then
    echo "warning: DIVE_CI_SKIP=1 — CI gate bypassed" >&2
    exit 0
fi
# Deleting refs needs no build. For every other ref, test the actual pushed tree.
changed=()
updates=0
full=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    updates=$((updates + 1))
    if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
        echo "pre-push: checkout $local_ref and push from its clean worktree so CI tests the pushed commit" >&2
        exit 1
    fi
    if [ -n "$(git status --porcelain --untracked-files=normal)" ]; then
        echo "pre-push: commit or stash changes first so CI tests the pushed commit" >&2
        exit 1
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        # Include every new commit, not just the tip. On a first push, test all
        # current files. Remote-tracking refs can be stale: extra checks are safe.
        if ! commits=$(git rev-list "$local_sha" --not --remotes="${1:-origin}"); then
            full=1
            continue
        fi
        if [ -z "$commits" ]; then
            # The branch already exists under another name on this remote.
            continue
        fi
        paths=$(mktemp)
        if ! printf '%s\n' "$commits" | git diff-tree --stdin --root -m -r --no-commit-id --name-only -z >"$paths"; then
            full=1
        else
            while IFS= read -r -d '' path; do changed+=("$path"); done <"$paths"
        fi
        unlink "$paths"
    else
        paths=$(mktemp)
        if ! git diff --name-only -z "$remote_sha" "$local_sha" >"$paths"; then
            full=1
        else
            while IFS= read -r -d '' path; do changed+=("$path"); done <"$paths"
        fi
        unlink "$paths"
    fi
done
[ "$updates" = 0 ] && exit 0
if [ ! -x "$GATE" ]; then
    echo "pre-push: $GATE missing — restore ci/ before pushing (or explicitly DIVE_CI_SKIP=1)" >&2
    exit 1
fi
if [ -n "${DIVE_CI_TIERS:-}" ]; then
    exec "$GATE" "$DIVE_CI_TIERS"
fi
if [ "$full" = 1 ]; then
    echo "pre-push: range unavailable — running all tiers" >&2
    exec "$GATE" all
fi
tiers="$("$GATE" tiers -- "${changed[@]}")"
echo "pre-push: $tiers"
# Tier names are validated by gate.sh; filenames never undergo word splitting.
read -r -a selected <<<"$tiers"
exec "$GATE" "${selected[@]}"
